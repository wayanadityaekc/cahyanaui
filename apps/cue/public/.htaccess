# Verified against Apache 2.4.66. Everything except the www redirect works with
# mod_rewrite DISABLED, so it cannot depend on a module Hostinger might not have.
# The one rewrite is wrapped in IfModule, so it is a no-op where that is missing.
#
# Goes in public/.htaccess so the Next build copies it into out/.
# Merge with the existing gzip + cache blocks from the current .htaccess.

Options -Indexes
DirectoryIndex index.html
ErrorDocument 404 /404.html

<FilesMatch "\.txt$">
  Require all denied
</FilesMatch>
<Files "robots.txt">
  Require all granted
</Files>


# --- Cache ---
# Situs lama punya blok ini di .htaccess-nya; export Next kehilangan, jadi
# Hostinger pakai default sendiri (CSS 7 hari, HTML tanpa aturan). Akibatnya
# style.css yang ke-cache rusak nyangkut seminggu dan nggak bisa diperbaiki.
#
# HTML WAJIB no-cache: itu satu-satunya file yang nunjuk ke URL ber-hash di
# bawahnya. Kalau HTML ikut ke-cache, build baru nggak pernah nyampe.
<IfModule mod_headers.c>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  # Aman dicache lama: chunk _next/ namanya ber-hash, style.css dipanggil
  # dengan ?v=<hash isi file> - dua-duanya ganti URL tiap kali isinya berubah.
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=31536000"
  </FilesMatch>
  <FilesMatch "\.(woff2?|ttf|otf)$">
    Header set Cache-Control "public, max-age=31536000"
  </FilesMatch>
  # Gambar nggak pakai versi, jadi sebulan - biar ganti foto tetap kepropagasi.
  <FilesMatch "\.(jpg|jpeg|png|webp|svg|ico|avif)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript
  AddOutputFilterByType DEFLATE application/javascript application/json
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# --- Satu host kanonik: www -> apex (301) ---
# www ngelayanin situs langsung, nggak redirect, jadi tamu yang mendarat di www
# kena blokir CORS di API: harga live, review, login, booking, contact semua mati
# padahal halamannya keliatan normal. Canonical + og:url juga nunjuk ke apex.
# Dibungkus IfModule: kalau mod_rewrite nggak ada, ini no-op (nggak error).
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]
</IfModule>

Redirect 301 /ubud-jeep-sunrise.html /kintamani-sunrise-penglipuran.html
Redirect 301 /taste-of-ubud.html /attractions/cooking-class.html
Redirect 301 /ubud-cooking-market.html /attractions/cooking-class.html
Redirect 301 /attractions/celuk-silver.html /attractions/ubud-arts-crafts.html
Redirect 301 /attractions/batik.html /attractions/ubud-arts-crafts.html
Redirect 301 /south-bali-tour.html /hidden-beaches-cliffs.html

# About/Contact/FAQ/Terms/Privacy/Cancellation folded into Our Company sections (Sep 2026).
Redirect 301 /about-us.html /our-company.html#about
Redirect 301 /contact.html /our-company.html#contact
Redirect 301 /faq.html /our-company.html#faq
Redirect 301 /terms-conditions.html /our-company.html#terms
Redirect 301 /privacy-policy.html /our-company.html#privacy
Redirect 301 /cancellation-policy.html /our-company.html#cancellation

# Besakih & Taman Ujung merged into the East Bali tour (Sep 2026, Wayan).
Redirect 301 /besakih-taman-ujung.html /lempuyang-tirta-gangga.html

# Ulun Danu Beratan & Handara Gate merged into the Bedugul highlands tour, and
# Sangeh Monkey Forest & Tanah Lot into the West Bali sunset tour (Sep 2026, Wayan).
Redirect 301 /ulun-danu-tanah-lot.html /jatiluwih-tour.html
Redirect 301 /sangeh-tanah-lot.html /tanah-lot-taman-ayun.html
