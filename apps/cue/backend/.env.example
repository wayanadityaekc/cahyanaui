# Contoh environment variables. COPY jadi `.env` buat jalanin lokal.
# JANGAN commit file `.env` beneran (udah di-.gitignore).

# Railway isi DATABASE_URL ini OTOMATIS pas Postgres nyambung.
# Buat tes lokal: copy connection string dari Railway Postgres > Connect.
DATABASE_URL=

# Domain frontend yang boleh manggil API (biar CORS aman).
ALLOWED_ORIGIN=https://cahyanaubudexperience.com

# Port. Railway set sendiri; lokal default 3000.
PORT=3000
