# Flat node_modules, the way npm lays them out.
#
# pnpm's default is a strict symlinked tree where a package can only see what it
# declares. That is the better default in general, but both apps here were built
# and are LIVE under npm's hoisted layout, and CUE in particular must keep
# working untouched through this migration. Hoisting removes a whole class of
# "worked before the monorepo, missing dependency now" failures that would
# otherwise have to be chased one by one.
#
# Worth revisiting once both apps are on the library and their dependency lists
# have been audited - strict mode would then catch real undeclared imports.
node-linker=hoisted
