{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": false,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.cahyanaubudexperience.com" }],
      "destination": "https://cahyanaubudexperience.com/:path*",
      "permanent": true
    },
    { "source": "/ubud-jeep-sunrise.html", "destination": "/kintamani-sunrise-penglipuran.html", "permanent": true },
    { "source": "/taste-of-ubud.html", "destination": "/attractions/cooking-class.html", "permanent": true },
    { "source": "/ubud-cooking-market.html", "destination": "/attractions/cooking-class.html", "permanent": true },
    { "source": "/attractions/celuk-silver.html", "destination": "/attractions/ubud-arts-crafts.html", "permanent": true },
    { "source": "/attractions/batik.html", "destination": "/attractions/ubud-arts-crafts.html", "permanent": true },
    { "source": "/south-bali-tour.html", "destination": "/hidden-beaches-cliffs.html", "permanent": true }
  ],
  "headers": [
    {
      "source": "/assets/fonts/:path*",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/assets/flags/:path*",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/assets/images/:path*",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=2592000" }]
    },
    {
      "source": "/assets/icons/:path*",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=2592000" }]
    },
    {
      "source": "/style.css",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000" }]
    },
    {
      "source": "/:path*.html",
      "headers": [{ "key": "Cache-Control", "value": "no-cache, must-revalidate" }]
    },
    {
      "source": "/",
      "headers": [{ "key": "Cache-Control", "value": "no-cache, must-revalidate" }]
    }
  ]
}
